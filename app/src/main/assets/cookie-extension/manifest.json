{
  "manifest_version": 2,
  "name": "Cookie Extractor",
  "version": "1.0",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "cookie-extractor@hikari.app"
    }
  }
}
